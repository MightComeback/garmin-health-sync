#!/usr/bin/env bash
set -euo pipefail

if [ -z "${LINEAR_API_KEY:-}" ]; then
  echo "LINEAR_API_KEY is not set" >&2
  exit 1
fi

api() {
  local query="$1"
  local variables_json="$2"
  curl -sS https://api.linear.app/graphql \
    -H "Authorization: ${LINEAR_API_KEY}" \
    -H "Content-Type: application/json" \
    -d "$(jq -nc --arg q "$query" --argjson v "$variables_json" '{query:$q, variables:$v}')"
}

parse_key() {
  local key="$1"
  if [[ ! "$key" =~ ^([A-Z0-9]+)-([0-9]+)$ ]]; then
    echo "Invalid issue key: $key (expected TEAM-123)" >&2
    exit 2
  fi
  TEAM_KEY="${BASH_REMATCH[1]}"
  ISSUE_NUM="${BASH_REMATCH[2]}"
}

usage() {
  echo "Usage: hakky-tools linear issue-state-type <TEAM-N> | hakky-tools linear comment <TEAM-N> <TEXT>" >&2
}

cmd=${1:-}
shift || true

case "$cmd" in
  linear)
    sub=${1:-}
    shift || true
    case "$sub" in
      issue-state-type)
        key=${1:?"issue key required (e.g. MIG-15)"}
        parse_key "$key"
        res=$(api 'query($team:String!,$num:Float!){ issues(filter:{ team:{ key:{ eq:$team } }, number:{ eq:$num }}){ nodes{ state{ type } } } }' "{\"team\":\"$TEAM_KEY\",\"num\":$ISSUE_NUM}")
        echo "$res" | jq -r '.data.issues.nodes[0].state.type // empty'
        ;;
      comment)
        key=${1:?"issue key required (e.g. MIG-15)"}
        shift
        body=${*:?"comment text required"}
        parse_key "$key"
        issueRes=$(api 'query($team:String!,$num:Float!){ issues(filter:{ team:{ key:{ eq:$team } }, number:{ eq:$num }}){ nodes{ id } } }' "{\"team\":\"$TEAM_KEY\",\"num\":$ISSUE_NUM}")
        issueId=$(echo "$issueRes" | jq -r '.data.issues.nodes[0].id // empty')
        if [ -z "$issueId" ]; then
          echo "Could not resolve issue id for $key" >&2
          exit 3
        fi
        api 'mutation($issueId:String!,$body:String!){ commentCreate(input:{issueId:$issueId, body:$body}){ success } }' "{\"issueId\":\"$issueId\",\"body\":$(jq -Rs . <<<"$body")}" >/dev/null
        ;;
      *)
        usage
        exit 64
        ;;
    esac
    ;;
  *)
    usage
    exit 64
    ;;
esac
